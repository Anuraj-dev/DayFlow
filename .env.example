APP_ENV=local
POSTGRES_USER=dayflow
POSTGRES_PASSWORD=dayflow
POSTGRES_DB=dayflow
# Backend container talks to the db service on 5432.
DATABASE_URL=postgresql+asyncpg://dayflow:dayflow@db:5432/dayflow
# Host-side Postgres is published at localhost:5433 so it does not collide with other local databases.
# For host pytest / uvicorn: postgresql+asyncpg://dayflow:dayflow@localhost:5433/dayflow

JWT_SECRET=change-me-in-local-env-use-a-long-random-string
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173

SEED_HR_EMAIL=hr@dayflow.demo
SEED_HR_PASSWORD=ChangeMe_HR12!
SEED_EMPLOYEE_EMAIL=employee@dayflow.demo
SEED_EMPLOYEE_PASSWORD=ChangeMe_Emp12!

API_PROXY_TARGET=http://backend:8000
